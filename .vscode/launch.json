{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run & debug app (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Serve FlashMaster",
      "postDebugTask": "Stop FlashMaster server",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-profile"
    },
    {
      "name": "Run & debug app (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Serve FlashMaster",
      "postDebugTask": "Stop FlashMaster server"
    },
    {
      "name": "Debug unit tests (all)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--test", "tests/unit/"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug unit test (current file)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--test", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug browser test (current file)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "${file}", "--project=desktop", "--headed", "--workers=1", "--timeout=0"],
      "cwd": "${workspaceFolder}",
      "env": { "PWDEBUG": "console" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
